{
  "name": "jinav",
  "version": "0.1.0",
  "description": "Cursor launcher with optional scoped desktop assistance",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && node scripts/start.mjs",
    "dev": "npm run start",
    "build": "node scripts/prepareDriver.mjs && node scripts/build.mjs",
    "icons": "node scripts/createIcon.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src scripts *.json *.mjs *.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test:desktop": "npm run build && node scripts/desktopSmoke.mjs",
    "test:package": "node scripts/packagedSmoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/manrope": "5.2.8",
    "agent-desktop": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "private": true
}
